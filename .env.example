# Example environment for Google Deepmind Embeddinggemma2.
#
# Copy this file to .env and fill in the values you need:
#
#   cp .env.example .env
#
# .env is git-ignored; .env.example is committed. Never put a real credential
# in this file -- every value below is empty, a dummy, or a safe default.
#
# Load them in code with python-dotenv (already a runtime dependency):
#
#   from dotenv import load_dotenv
#   load_dotenv()
#
# Pipeline wiring (paths, stage inputs/outputs) does NOT live here -- that is
# config/config.yaml, and the tunable knobs are params.yaml. Use .env only for
# machine-specific settings and secrets.

# --- Runtime -----------------------------------------------------------------
# Free-form label for the environment the code is running in.
ENVIRONMENT=development
# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# Where the package writes running_logs.log. Defaults to logs/ when unset.
LOG_DIR=logs
# Repository root used to resolve config/config.yaml and params.yaml. Leave it
# blank to let the package discover the root itself; set it only when running
# from a directory that is not a checkout (a container, a scheduled job, ...).
PROJECT_ROOT=

# --- Flask app (read by app.py) ----------------------------------------------
HOST=127.0.0.1
PORT=8080
# 1 enables the reloader and the interactive debugger. Keep it 0 anywhere that
# is not your own machine.
FLASK_DEBUG=0

# --- Data sources (optional) -------------------------------------------------
# Set these when your ingestion stage pulls from an authenticated endpoint
# instead of the public URL in config/config.yaml.
DATA_SOURCE_URL=
DATA_SOURCE_TOKEN=
# Kaggle API credentials, copied out of ~/.kaggle/kaggle.json.
KAGGLE_USERNAME=
KAGGLE_KEY=

# --- DVC remote storage (optional) -------------------------------------------
# Credentials for the remote you configure with `dvc remote add`. Install the
# matching extra too, e.g. `pip install dvc[s3]`.
DVC_REMOTE_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# e.g. eu-west-1, us-east-1
AWS_DEFAULT_REGION=

# --- Experiment tracking (optional) ------------------------------------------
# Not wired up by default: add `mlflow` to requirements.txt and log from your
# training stage first. URI e.g. http://127.0.0.1:5000 for a local server.
MLFLOW_TRACKING_URI=
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=
